ARG ALPINE_VERSION=3.24
ARG ALPINE_DIGEST=sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
FROM alpine:${ALPINE_VERSION}@${ALPINE_DIGEST}

RUN apk add --no-cache bash curl git ca-certificates coreutils libstdc++

ARG HERMES_COMMIT
ARG HERMES_VERSION
ARG FORK_REVISION
ARG PATCH_HASH
ARG VARIANT=full

# Clone the prepared checkout into place so the installer takes its existing-checkout path.
# The .git is a read-only bind mount, so it adds no layer (the clone stays).
RUN --mount=type=bind,from=srcgit,target=/src/hermes.git \
    --mount=type=bind,source=slim.sh,target=/src/slim.sh \
    git clone --quiet --branch image-build file:///src/hermes.git /root/.hermes/hermes-agent \
    && HERMES_HOME=/root/.hermes HERMES_REPO_URL=file:///src/hermes.git \
        bash /root/.hermes/hermes-agent/scripts/install.sh --branch image-build --commit "${HERMES_COMMIT}" \
        --non-interactive --skip-browser --skip-computer-use \
    && git -C /root/.hermes/hermes-agent repack -adq \
    && export PATH="/root/.local/bin:${PATH}" \
    && ln -sf "$(command -v hermes)" /usr/local/bin/hermes \
    && mkdir -p /root/.hermes/profiles/android \
    && rm -rf /root/.hermes/.env /root/.hermes/telemetry /root/.hermes/cache/uv /root/.cache /root/.npm /tmp/* /var/cache/apk/* \
    && bash /src/slim.sh "${VARIANT}"

COPY profile.d/hermes.sh /etc/profile.d/hermes.sh
ENV HERMES_HOME=/root/.hermes/profiles/android

LABEL org.opencontainers.image.source="https://github.com/oonid/hermes-agent" \
      org.opencontainers.image.description="Alpine Linux with Hermes Agent preinstalled" \
      org.opencontainers.image.version="${HERMES_VERSION}" \
      org.opencontainers.image.revision="${FORK_REVISION}" \
      io.github.oonid.hermes.upstream-commit="${HERMES_COMMIT}" \
      io.github.oonid.hermes.patch-hash="${PATCH_HASH}" \
      io.github.oonid.hermes.variant="${VARIANT}"

CMD ["hermes"]
